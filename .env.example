# Claude API キー（https://platform.claude.com/ で発行）。未設定でも簡易モードで動きます。
ANTHROPIC_API_KEY=sk-ant-...
# 使うモデル（省略時 claude-opus-5-5。コストを抑えるなら claude-sonnet-5-5）
# EIGYO_MODEL=claude-sonnet-5-5
# DB の保存先（省略時 data/eigyo.db）
# EIGYO_DB_PATH=./data/eigyo.db
# 外出先からスマホで使うときのアクセスキー（npm run tunnel で公開する前に必ず設定）
# EIGYO_ACCESS_KEY=好きな合言葉
# 自分宛てメール（スマホから見積書を自分に送る。得意先には送らない）。未設定ならスマホの共有メニューで送る
# EIGYO_SELF_EMAIL=you@example.jp
# EIGYO_SMTP_HOST=smtp.example.jp
# EIGYO_SMTP_PORT=587
# EIGYO_SMTP_USER=you@example.jp
# EIGYO_SMTP_PASS=（メールのパスワードまたはアプリパスワード）
# EIGYO_SMTP_FROM=you@example.jp
# Google カレンダー連携（任意）。Google Cloud の OAuth クライアント（ウェブ）。リダイレクト URI は {公開URL}/api/google/callback
# GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=xxxx
